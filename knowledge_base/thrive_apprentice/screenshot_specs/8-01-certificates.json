          "raw_text": "Navigate to **Thrive Apprentice** > **Settings** > **Email Templates**.",
          "action": "navigate",
          "target": "Thrive Apprentice",
          "target_bold": true,
          "has_target": true,
          "context": "> Settings > Email Templates"
        },
        {
          "step_num": 2,
          "raw_text": "Locate or create a **Course Completion** email template.",
          "action": "locate",
          "target": "Course Completion",
          "target_bold": true,
          "has_target": true,
          "context": "email template"
        },
        {
          "step_num": 3,
          "raw_text": "In the email body, add the certificate download link using the available dynamic shortcodes.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Customize the subject line and body text to congratulate the student and provide instructions for downloading their certificate.",
          "action": "locate",
          "target": "Subject Line",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Save the email template.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
