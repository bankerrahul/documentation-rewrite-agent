    {
      "heading": "Enabling Certificate Verification",
      "heading_slug": "enabling-certificate-verification",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Go to the **Certificates** tab and open your certificate template.",
          "action": "navigate",
          "target": "Certificates",
          "target_bold": true,
          "has_target": true,
          "context": "tab and open your certificate template"
        },
        {
          "step_num": 2,
          "raw_text": "Find the **Verification** toggle and enable it.",
          "action": "locate",
          "target": "Verification",
          "target_bold": true,
          "has_target": true,
          "context": "toggle and enable it"
        },
        {
          "step_num": 3,
          "raw_text": "Once enabled, each generated certificate will include a unique verification URL.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Students and employers can visit this URL to confirm the certificate is valid and view details like the student's name, course title, and completion date.",
          "action": "locate",
          "target": "Course Title",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
    {
      "heading": "Adding a Download Certificate Button",
      "heading_slug": "adding-a-download-certificate-button",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Open the page or lesson where you want to add the download button in **Thrive Architect**.",
          "action": "navigate",
          "target": "Thrive Architect",
          "target_bold": true,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "From the element panel, drag and drop the **Download Certificate** button element onto the page.",
          "action": "locate",
          "target": "Download Certificate",
          "target_bold": true,
          "has_target": true,
          "context": "button element onto the page"
        },
        {
          "step_num": 3,
          "raw_text": "Customize the button text (e.g., \"Download Your Certificate\"), style, and placement.",
          "action": "locate",
          "target": "Download Your Certificate",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "The button automatically links to the student's personalized certificate PDF—no manual linking needed.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Click **Save Work** to apply your changes.",
          "action": "click",
          "target": "Save Work",
          "target_bold": true,
          "has_target": true,
          "context": "apply your changes"
        }
      ]
    },
    {
