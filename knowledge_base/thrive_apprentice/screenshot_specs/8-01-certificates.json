{
  "filename": "8-01-certificates.md",
  "title": "How to Issue Course Completion Certificates in Thrive Apprentice",
  "sections": [
    {
      "heading": "Creating a Certificate Template",
      "heading_slug": "creating-a-certificate-template",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "In your WordPress dashboard, navigate to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "locate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Click the **Certificates** tab in the left sidebar.",
          "action": "click",
          "target": "Certificates",
          "target_bold": true,
          "has_target": true,
          "context": "tab in the left sidebar"
        },
        {
          "step_num": 3,
          "raw_text": "Click **Add New Certificate** to create a new template.",
          "action": "click",
          "target": "Add New Certificate",
          "target_bold": true,
          "has_target": true,
          "context": "create a new template"
        },
        {
          "step_num": 4,
          "raw_text": "Give your certificate a descriptive name (e.g., \"Standard Completion Certificate\").",
          "action": "locate",
          "target": "Standard Completion Certificate",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Click **Edit Design** to open the certificate in the visual editor.",
          "action": "click",
          "target": "Edit Design",
          "target_bold": true,
          "has_target": true,
          "context": "open the certificate in the visual editor"
        },
        {
          "step_num": 6,
          "raw_text": "Design your certificate layout using the drag-and-drop builder—add text elements, images, borders, logos, and background colors to match your brand.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 7,
          "raw_text": "Click **Save Work** when you're finished, then click **Done** to return to the Certificates screen.",
          "action": "click",
          "target": "Save Work",
          "target_bold": true,
          "has_target": true,
          "context": "when you're finished, then click Done to return to the Certificates screen"
        }
      ]
    },
    {
      "heading": "Using Dynamic Data in Your Certificate",
      "heading_slug": "using-dynamic-data-in-your-certificate",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "While editing your certificate template in the visual editor, click on a text element where you want to insert dynamic content.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "Look for the **Dynamic Text** option in the text element toolbar.",
          "action": "locate",
          "target": "Dynamic Text",
          "target_bold": true,
          "has_target": true,
          "context": "option in the text element toolbar"
        },
        {
          "step_num": 3,
          "raw_text": "Select from the available dynamic fields:",
          "action": "click",
          "target": "From The Available Dynamic Fields:",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Position and style the dynamic text elements to fit your certificate design.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Click **Save Work** to preserve your changes.",
          "action": "click",
          "target": "Save Work",
          "target_bold": true,
          "has_target": true,
          "context": "preserve your changes"
        }
      ]
    },
    {
      "heading": "Assigning a Certificate to a Course",
      "heading_slug": "assigning-a-certificate-to-a-course",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Go to the **Courses** tab and open the course you want to add a certificate to.",
          "action": "navigate",
          "target": "Courses",
          "target_bold": true,
          "has_target": true,
          "context": "tab and open the course you want to add a certificate to"
        },
        {
          "step_num": 2,
          "raw_text": "In the course settings, locate the **Certificate** section.",
          "action": "locate",
          "target": "Certificate",
          "target_bold": true,
          "has_target": true,
          "context": "section"
        },
        {
          "step_num": 3,
          "raw_text": "Select your certificate template from the dropdown list.",
          "action": "click",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Click **Save** to apply the certificate to the course.",
          "action": "click",
          "target": "Save",
          "target_bold": true,
          "has_target": true,
          "context": "apply the certificate to the course"
        }
      ]
    },
    {
