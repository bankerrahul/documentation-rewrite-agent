          "has_target": true,
          "context": "tab to view your active design"
        },
        {
          "step_num": 3,
          "raw_text": "Click **Edit Design** on the Legacy design block.",
          "action": "click",
          "target": "Edit Design",
          "target_bold": true,
          "has_target": true,
          "context": "Legacy design block"
        },
        {
          "step_num": 4,
          "raw_text": "Use the available options to adjust colors, fonts, and layout settings for your course pages.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Save your changes when finished.",
          "action": "locate",
          "target": "Save",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    }
  ]
