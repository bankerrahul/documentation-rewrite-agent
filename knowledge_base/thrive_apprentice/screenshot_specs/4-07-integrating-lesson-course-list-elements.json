          "target": "Course List",
          "target_bold": true,
          "has_target": true,
          "context": "or Lesson List"
        },
        {
          "step_num": 3,
          "raw_text": "Drag the element onto the page.",
          "action": "drag",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Configure the element settings as needed.",
          "action": "locate",
          "target": "Element Settings As Needed",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Save and publish the page.",
          "action": "locate",
          "target": "Save",
          "target_bold": false,
