{
  "filename": "6-02-integrating-membership-plugins.md",
  "title": "How to Integrate Membership Plugins with Thrive Apprentice",
  "sections": [
    {
      "heading": "How Membership Plugins Work with Thrive Apprentice",
      "heading_slug": "how-membership-plugins-work-with-thrive-apprentice",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "The membership plugin manages your users, membership levels, and payments.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "Users sign up or purchase a membership through the membership plugin.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "Thrive Apprentice reads the membership level data from the plugin.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "You configure access requirements on your Thrive Apprentice products to restrict courses to specific membership levels.",
          "action": "locate",
          "target": "Access Requirements",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "When a user logs in, Thrive Apprentice checks their membership status and grants or denies course access automatically.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        }
      ]
    },
    {
      "heading": "How to Set Up WishList Member Access",
      "heading_slug": "how-to-set-up-wishlist-member-access",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Go to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "navigate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Click **Products** in the left sidebar.",
          "action": "click",
          "target": "Products",
          "target_bold": true,
          "has_target": true,
          "context": "left sidebar"
        },
        {
          "step_num": 3,
          "raw_text": "Select the product you want to protect.",
          "action": "click",
          "target": "Product You Want",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Click the **Access requirements** tab.",
          "action": "click",
          "target": "Access requirements",
          "target_bold": true,
          "has_target": true,
          "context": "tab"
        },
        {
          "step_num": 5,
          "raw_text": "In the access requirements panel on the right, look for the WishList Member protection options.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 6,
          "raw_text": "Select the WishList Member membership level(s) that should grant access to this product.",
          "action": "click",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 7,
          "raw_text": "Save your changes.",
          "action": "locate",
          "target": "Save",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
