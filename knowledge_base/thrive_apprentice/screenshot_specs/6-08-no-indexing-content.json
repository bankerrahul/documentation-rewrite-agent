    {
      "heading": "Verifying Your No-Index Settings",
      "heading_slug": "verifying-your-no-index-settings",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Open the lesson or course page you've set to no-index in your browser.",
          "action": "navigate",
          "target": "Lesson",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "Right-click on the page and select **View Page Source**.",
          "action": "locate",
          "target": "View Page Source",
          "target_bold": true,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "Search for `noindex` in the page source code.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "You should find a meta tag like: `<meta name=\"robots\" content=\"noindex\"/>` in the `<head>` section of the page.",
          "action": "locate",
          "target": "robots",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
