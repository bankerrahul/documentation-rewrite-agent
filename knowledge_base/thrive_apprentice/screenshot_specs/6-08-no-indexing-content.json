{
  "filename": "6-08-no-indexing-content.md",
  "title": "How to No-Index Thrive Apprentice Content with SEO Plugins",
  "sections": [
    {
      "heading": "No-Index Individual Lessons, Modules, or Chapters",
      "heading_slug": "no-index-individual-lessons-modules-or-chapters",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Open the lesson, module, or chapter you want to no-index in the WordPress editor.",
          "action": "navigate",
          "target": "Lesson",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "Scroll down to the **Yoast SEO** meta box below the content area.",
          "action": "scroll",
          "target": "Yoast SEO",
          "target_bold": true,
          "has_target": true,
          "context": "meta box below the content area"
        },
        {
          "step_num": 3,
          "raw_text": "Click the **Advanced** tab (the gear icon) within the Yoast SEO box.",
          "action": "click",
          "target": "Advanced",
          "target_bold": true,
          "has_target": true,
          "context": "tab (the gear icon) within the Yoast SEO box"
        },
        {
          "step_num": 4,
          "raw_text": "Find the **Allow search engines to show this content in search results?** dropdown.",
          "action": "locate",
          "target": "Allow search engines to show this content in search results?",
          "target_bold": true,
          "has_target": true,
          "context": "dropdown"
        },
        {
          "step_num": 5,
          "raw_text": "Select **No** to set the page to no-index.",
          "action": "click",
          "target": "No",
          "target_bold": true,
          "has_target": true,
          "context": "set the page to no-index"
        },
        {
          "step_num": 6,
          "raw_text": "Update or publish the page.",
          "action": "click",
          "target": "Publish",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
    {
      "heading": "No-Index All Content of a Specific Type",
      "heading_slug": "no-index-all-content-of-a-specific-type",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "In your WordPress admin, go to **Yoast SEO** > **Settings**.",
          "action": "locate",
          "target": "Yoast SEO",
          "target_bold": true,
          "has_target": true,
          "context": "> Settings"
        },
        {
          "step_num": 2,
          "raw_text": "Navigate to the **Content types** section.",
          "action": "navigate",
          "target": "Content types",
          "target_bold": true,
          "has_target": true,
          "context": "section"
        },
        {
          "step_num": 3,
          "raw_text": "Find the Thrive Apprentice content types (Lessons, Modules, Chapters).",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "For each content type you want to hide, set the **Show in search results** toggle to **Off**.",
          "action": "locate",
          "target": "Show in search results",
          "target_bold": true,
          "has_target": true,
          "context": "toggle to Off"
        },
        {
          "step_num": 5,
          "raw_text": "Save your changes.",
          "action": "locate",
          "target": "Save",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
    {
      "heading": "No-Index Individual Lessons, Modules, or Chapters",
      "heading_slug": "no-index-individual-lessons-modules-or-chapters",
      "steps": [
