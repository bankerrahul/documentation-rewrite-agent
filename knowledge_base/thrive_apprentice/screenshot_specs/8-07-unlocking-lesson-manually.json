{
  "filename": "8-07-unlocking-lesson-manually.md",
  "title": "How to Unlock a Lesson for Users Manually in Thrive Apprentice",
  "sections": [
    {
      "heading": "Unlocking a Lesson from the Member Profile",
      "heading_slug": "unlocking-a-lesson-from-the-member-profile",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "In your WordPress dashboard, navigate to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "locate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Click the **Members** tab in the left sidebar.",
          "action": "click",
          "target": "Members",
          "target_bold": true,
          "has_target": true,
          "context": "tab in the left sidebar"
        },
        {
          "step_num": 3,
          "raw_text": "Search for and click on the student's name to open their profile.",
          "action": "locate",
          "target": "On The Student'S Name",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Locate the course that contains the lesson you want to unlock.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Find the specific lesson in the student's course progress view.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 6,
          "raw_text": "Click the **Unlock** option next to the locked lesson.",
          "action": "click",
          "target": "Unlock",
          "target_bold": true,
          "has_target": true,
          "context": "option next to the locked lesson"
        },
        {
          "step_num": 7,
          "raw_text": "Confirm the action when prompted.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        }
      ]
    },
    {
      "heading": "Unlocking a Lesson from the Course View",
      "heading_slug": "unlocking-a-lesson-from-the-course-view",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Navigate to **Thrive Apprentice** > **Courses**.",
          "action": "navigate",
          "target": "Thrive Apprentice",
          "target_bold": true,
          "has_target": true,
          "context": "> Courses"
        },
        {
          "step_num": 2,
          "raw_text": "Open the course that contains the lesson you want to unlock.",
          "action": "navigate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "Click on the specific lesson to view its settings.",
          "action": "click",
          "target": "On The Specific Lesson",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Look for the student access or enrollment section within the lesson settings.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Search for the student by name or email.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 6,
          "raw_text": "Click **Unlock** next to the student's entry to grant them access to this lesson.",
          "action": "click",
          "target": "Unlock",
          "target_bold": true,
          "has_target": true,
          "context": "next to the student's entry to grant them access to this lesson"
        },
        {
          "step_num": 7,
          "raw_text": "Click **Save** if required.",
          "action": "click",
          "target": "Save",
          "target_bold": true,
          "has_target": true,
          "context": "if required"
        }
      ]
    }
  ]
}