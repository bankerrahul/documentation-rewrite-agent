    {
      "heading": "Self-Registration",
      "heading_slug": "self-registration",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Ensure registration is enabled under **Settings** > **Login & Access Restriction**.",
          "action": "locate",
          "target": "Settings",
          "target_bold": true,
          "has_target": true,
          "context": "> Login & Access Restriction"
        },
        {
          "step_num": 2,
          "raw_text": "Verify that your registration page is published and accessible.",
          "action": "locate",
          "target": "Publish",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "When a visitor registers, Thrive Apprentice creates a new WordPress user account for them.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "The new user receives a welcome email with their login details.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        }
      ]
    },
    {
      "heading": "Manually Granting Access",
      "heading_slug": "manually-granting-access",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Go to the **Members** section in Thrive Apprentice.",
          "action": "navigate",
          "target": "Members",
          "target_bold": true,
          "has_target": true,
          "context": "section in Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Click **Add Member** or locate an existing WordPress user.",
