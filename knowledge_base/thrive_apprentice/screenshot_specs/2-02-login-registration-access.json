    {
      "heading": "Setting Up a Login and Registration Page",
      "heading_slug": "setting-up-a-login-and-registration-page",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Navigate to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "navigate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Click **Settings** in the left sidebar.",
          "action": "click",
          "target": "Settings",
          "target_bold": true,
          "has_target": true,
          "context": "left sidebar"
        },
        {
          "step_num": 3,
          "raw_text": "Select the **Login & Access Restriction** tab.",
          "action": "click",
          "target": "Login & Access Restriction",
          "target_bold": true,
          "has_target": true,
          "context": "tab"
        },
        {
          "step_num": 4,
          "raw_text": "In the **Login Page** section, click **Add a Login Page** (or select an existing page from the dropdown).",
          "action": "locate",
          "target": "Login Page",
          "target_bold": true,
          "has_target": true,
          "context": "section, click Add a Login Page (or select an existing page from the dropdown)"
        },
        {
          "step_num": 5,
          "raw_text": "Customize your login page settings—including form fields, branding, and redirect behavior.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 6,
          "raw_text": "In the **Registration** section, enable registration if you want new users to create accounts on their own.",
          "action": "locate",
          "target": "Registration",
          "target_bold": true,
          "has_target": true,
          "context": "section, enable registration if you want new users to create accounts on their o"
        },
        {
          "step_num": 7,
          "raw_text": "Configure registration fields and any welcome email preferences.",
          "action": "locate",
          "target": "Registration Fields",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 8,
          "raw_text": "Click **Save** to apply your changes.",
          "action": "click",
          "target": "Save",
          "target_bold": true,
          "has_target": true,
          "context": "apply your changes"
        }
      ]
    },
