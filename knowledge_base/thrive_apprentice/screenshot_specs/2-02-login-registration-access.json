          "context": "or locate an existing WordPress user"
        },
        {
          "step_num": 3,
          "raw_text": "Select the products you want to grant them access to.",
          "action": "click",
          "target": "Products You Want",
          "target_bold": false,
          "has_target": true,
          "context": ""
