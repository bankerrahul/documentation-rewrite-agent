      "heading": "Navigating the Products Section",
      "heading_slug": "navigating-the-products-section",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Go to your WordPress admin dashboard.",
          "action": "navigate",
          "target": "Your Wordpress Admin Dashboard",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "Navigate to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "navigate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 3,
          "raw_text": "Click **Products** in the left sidebar.",
          "action": "click",
          "target": "Products",
          "target_bold": true,
          "has_target": true,
          "context": "left sidebar"
        }
      ]
    },
    {
      "heading": "Creating a New Product",
      "heading_slug": "creating-a-new-product",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Navigate to **Thrive Dashboard** > **Thrive Apprentice** > **Products**.",
          "action": "navigate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice > Products"
        },
        {
          "step_num": 2,
          "raw_text": "Click the **+ Add New Product** button (or **+ Create your first product** if you haven't created one yet).",
          "action": "click",
          "target": "+ Add New Product",
          "target_bold": true,
          "has_target": true,
          "context": "button (or + Create your first product if you haven't created one yet)"
        },
        {
          "step_num": 3,
          "raw_text": "Enter a name for your product in the popup dialog that appears.",
          "action": "type",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Click **Create Product** to confirm.",
          "action": "click",
          "target": "Create Product",
          "target_bold": true,
          "has_target": true,
          "context": "confirm"
        }
      ]
    },
    {
      "heading": "Assigning Courses to a Product",
      "heading_slug": "assigning-courses-to-a-product",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Open the product you want to edit.",
          "action": "navigate",
          "target": "Product You Want",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "Click the **Course Content** tab (or **Add Content** section).",
          "action": "click",
          "target": "Course Content",
          "target_bold": true,
          "has_target": true,
          "context": "tab (or Add Content section)"
        },
        {
          "step_num": 3,
          "raw_text": "Click **+ Add Course** to see a list of available courses.",
          "action": "click",
          "target": "+ Add Course",
          "target_bold": true,
          "has_target": true,
          "context": "see a list of available courses"
        },
        {
          "step_num": 4,
          "raw_text": "Select the courses you want to include in this product.",
          "action": "click",
          "target": "Courses You Want",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Click **Add** to assign them.",
          "action": "click",
          "target": "Add",
          "target_bold": true,
          "has_target": true,
          "context": "assign them"
        }
      ]
    }
  ]
