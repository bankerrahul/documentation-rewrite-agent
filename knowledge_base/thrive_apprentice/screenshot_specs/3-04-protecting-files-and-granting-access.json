  "sections": [
    {
      "heading": "Protecting Files in Thrive Apprentice",
      "heading_slug": "protecting-files-in-thrive-apprentice",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Navigate to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "navigate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Click **Protected Files** in the left sidebar.",
          "action": "click",
          "target": "Protected Files",
          "target_bold": true,
          "has_target": true,
          "context": "left sidebar"
        },
        {
          "step_num": 3,
          "raw_text": "Click **+ Add New File** to upload a file or select one from your WordPress media library.",
          "action": "click",
          "target": "+ Add New File",
          "target_bold": true,
          "has_target": true,
          "context": "upload a file or select one from your WordPress media library"
        },
        {
          "step_num": 4,
          "raw_text": "Enter a descriptive name for the file so you can easily identify it later.",
          "action": "type",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Click **Save** to add the file to your protected files library.",
          "action": "click",
          "target": "Save",
          "target_bold": true,
          "has_target": true,
          "context": "add the file to your protected files library"
        }
      ]
    },
    {
      "heading": "Granting File Access to Products and Courses",
      "heading_slug": "granting-file-access-to-products-and-courses",
      "steps": [
        {
