          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 2,
          "raw_text": "In the **Access Restriction Rules** section, click **+ Add Rule**.",
          "action": "locate",
          "target": "Access Restriction Rules",
          "target_bold": true,
          "has_target": true,
          "context": "section, click + Add Rule"
        },
        {
          "step_num": 3,
          "raw_text": "Choose the access condition:",
          "action": "click",
          "target": "Access Condition:",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
