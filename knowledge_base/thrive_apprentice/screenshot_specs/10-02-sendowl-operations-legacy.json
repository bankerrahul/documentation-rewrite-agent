          "has_target": true,
          "context": "open the product you want to link"
        },
        {
          "step_num": 2,
          "raw_text": "Copy the **Direct Checkout URL** from the product's sharing options.",
          "action": "locate",
          "target": "Direct Checkout URL",
          "target_bold": true,
          "has_target": true,
          "context": "product's sharing options"
        },
        {
          "step_num": 3,
          "raw_text": "Use this URL in your buttons, emails, or landing pages to send customers directly to payment.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        }
