      "heading": "Customizing Checkout Templates",
      "heading_slug": "customizing-checkout-templates",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "In **SendOwl**, go to **Settings** > **Checkout Templates**.",
          "action": "locate",
          "target": "SendOwl",
          "target_bold": true,
          "has_target": true,
          "context": "go to Settings > Checkout Templates"
        },
        {
          "step_num": 2,
          "raw_text": "Select an existing template or click **Create New**.",
          "action": "click",
          "target": "Create New",
          "target_bold": true,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "Customize the layout, colors, logo, and text fields.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Assign the template to your products under each product's settings.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
    {
