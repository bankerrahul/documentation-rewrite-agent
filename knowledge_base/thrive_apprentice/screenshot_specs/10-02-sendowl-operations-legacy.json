          "target": "SendOwl",
          "target_bold": true,
          "has_target": true,
          "context": "go to Marketing > Discount Codes"
        },
        {
          "step_num": 2,
          "raw_text": "Click **Create Discount Code**.",
          "action": "click",
          "target": "Create Discount Code",
          "target_bold": true,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "Set the code name, discount type (percentage or fixed amount), and expiration date.",
