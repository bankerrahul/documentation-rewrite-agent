  "title": "How to Refresh Templates in Thrive Apprentice After Adding Assessments",
  "sections": [
    {
      "heading": "How to Refresh Your Templates",
      "heading_slug": "how-to-refresh-your-templates",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Navigate to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "navigate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Open the course where you've added assessments.",
          "action": "navigate",
          "target": "Course Where You'Ve Added Assessments",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "Look for the template refresh notice at the top of the page or in the course editor.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Click the **Refresh Templates** button (or **Reload Lesson List Template**, depending on the notice).",
          "action": "click",
          "target": "Refresh Templates",
          "target_bold": true,
          "has_target": true,
          "context": "button (or Reload Lesson List Template, depending on the notice)"
        },
        {
          "step_num": 5,
          "raw_text": "Wait a few seconds for Thrive Apprentice to update the templates.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 6,
          "raw_text": "Once complete, you'll see a confirmation that the templates have been refreshed.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 7,
          "raw_text": "Preview your course on the front end to verify that assessments now appear correctly in the lesson list and on individual lesson pages.",
          "action": "locate",
          "target": "",
          "target_bold": false,
          "has_target": false,
          "context": ""
        }
      ]
    }
