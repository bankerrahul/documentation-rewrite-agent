{
  "filename": "4-03-template-types-reference.md",
  "title": "Thrive Apprentice Template Types Reference",
  "sections": [
    {
      "heading": "How to Add Any Template",
      "heading_slug": "how-to-add-any-template",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Go to **Thrive Dashboard** > **Thrive Apprentice**.",
          "action": "navigate",
          "target": "Thrive Dashboard",
          "target_bold": true,
          "has_target": true,
          "context": "> Thrive Apprentice"
        },
        {
          "step_num": 2,
          "raw_text": "Click the **Design** tab in the left sidebar.",
          "action": "click",
          "target": "Design",
          "target_bold": true,
          "has_target": true,
          "context": "tab in the left sidebar"
        },
        {
          "step_num": 3,
          "raw_text": "Click **Edit Design** on the design you want to modify.",
          "action": "click",
          "target": "Edit Design",
          "target_bold": true,
          "has_target": true,
          "context": "design you want to modify"
        },
        {
          "step_num": 4,
          "raw_text": "Navigate to the template type you want to add.",
          "action": "navigate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 5,
          "raw_text": "Click the option to add a new template.",
          "action": "click",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 6,
          "raw_text": "Choose whether to start from a pre-built template or build from scratch.",
          "action": "click",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 7,
          "raw_text": "Customize the template using the visual editor.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 8,
          "raw_text": "Save your changes.",
          "action": "locate",
          "target": "Save",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
    {
      "heading": "1. Course Overview Template",
      "heading_slug": "1-course-overview-template",
      "steps": [
        {
          "step_num": 1,
          "raw_text": "Open your design and navigate to the **Course Overview** section in the template editor.",
          "action": "navigate",
          "target": "Course Overview",
          "target_bold": true,
          "has_target": true,
          "context": "section in the template editor"
        },
        {
          "step_num": 2,
          "raw_text": "A default Course Overview template is included. Click the option to add a new one if needed.",
          "action": "locate",
          "target": "Course Overview",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 3,
          "raw_text": "Customize the layout to include the elements you want—such as course title, description, video, lesson list, and call-to-action buttons.",
          "action": "locate",
          "target": "Course Title",
          "target_bold": false,
          "has_target": true,
          "context": ""
        },
        {
          "step_num": 4,
          "raw_text": "Save your template.",
          "action": "locate",
          "target": "Design",
          "target_bold": false,
          "has_target": true,
          "context": ""
        }
      ]
    },
